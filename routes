if token_json.get("error"):
            raise HTTPException(
                status_code=500,
                detail=f"TigerGraph token error: {token_json.get('message')}",
            )

        jwt_token = token_json.get("token")
        if not jwt_token:
            raise HTTPException(
                status_code=500,
                detail="TigerGraph token response did not contain 'token'",
            )

        # -----------------------------------------------
        # Step 4: Call TG execution API with that JWT
        # -----------------------------------------------
        # Here we are calling POST /gsqlserver/interpreted_query
        # with Authorization: Bearer <token>
        exec_headers = {
            "Authorization": f"Bearer {jwt_token}",
            "Content-Type": "application/json",
            "Accept": "application/json",
        }

        # Different deployments expect slightly different body shapes.
        # Here we send the raw GSQL as a field named "gsql".
        exec_body = {"gsql": query}

        exec_resp = requests.post(
            TG_EXECUTE_URL,
            headers=exec_headers,
            json=exec_body,
            timeout=60,
        )

        if exec_resp.status_code != 200:
            raise HTTPException(
                status_code=500,
                detail=f"TigerGraph execute failed: {exec_resp.text}",
            )

        # If TigerGraph returns JSON, parse it.
        # If it returns plain text instead, use exec_resp.text.
        try:
            tg_result = exec_resp.json()
        except ValueError:
            tg_result = {"raw_response": exec_resp.text}

        # -----------------------------------------------
        # Step 5: Return everything back to caller (UI)
        # -----------------------------------------------
        return {
            "status": "success",
            "clean_gsql": query,   # GSQL after cleaning "Final GSQL:"
            "tg_result": tg_result # whatever TG sent back
        }

    except HTTPException:
        # Re-throw HTTPException as is so FastAPI returns correct status
        raise
    except Exception as e:
        # Any other unexpected error → wrap as 500
        raise HTTPException(status_code=500, detail=str(e))
